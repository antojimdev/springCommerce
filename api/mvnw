# This script will download maven and run the build

set -e

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn() {
  echo "$*" >&2
}

die() {
  echo
  echo "$*"
  echo
  exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
ls_opts="-la"
case "$(uname)" in
  CYGWIN* )
    cygwin=true
    ls_opts="-la --show-control-chars"
    ;;
  Darwin* )
    darwin=true
    ls_opts="-La"
    ;;
  MINGW* )
    msys=true
    ;;
  NONSTOP* )
    nonstop=true
    ;;
esac

# Increase the maximum file descriptors if we can.
if [ "$MAX_FD" = "maximum" ] || [ "$MAX_FD" = "max" ]; then
  MAX_FD_LIMIT=$(ulimit -H -n) || true
  if [ $? -eq 0 ]; then
    if [ "$MAX_FD_LIMIT" != "unlimited" ]; then
      MAX_FD="$MAX_FD_LIMIT"
    else
      MAX_FD="" # use the system max
    fi
  else
    warn "Could not query system maximum file descriptor limit: $MAX_FD_LIMIT"
  fi
  if [ -n "$MAX_FD" ] && [ "$MAX_FD" -gt 0 ]; then
    ulimit -n "$MAX_FD" || warn "Could not set maximum file descriptor limit: $MAX_FD"
  fi
  unset MAX_FD_LIMIT
fi

# Collect all arguments for the java command, stacking in reverse order
CMD_LINE_ARGS=""
for arg in "$@"; do
  case $arg in
    --) shift; break ;;
    *) CMD_LINE_ARGS="$arg $CMD_LINE_ARGS" ;;
  esac
done

# When using eval with a dollar sign in a for loop, you might run into issues
# with the shell wrapping up the value of "$arg" in double quotes, which
# would prevent it from being split into separate program arguments.
# Use the xargs line below to regenerate the "$@" that would have been
# passed when all the arguments were quoted.
eval "set -- $(echo "$CMD_LINE_ARGS" | xargs)"

WRAPPER_DIR="$(cd -P -- "$(dirname -- "$0")" && pwd -P)"
WRAPPER_JAR="${WRAPPER_DIR}/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"

MVN_JAR_DIR="${WRAPPER_DIR}"
MVN_JAR="${MVN_JAR_DIR}/maven-wrapper.jar"

# if we have a jar, we can skip the download
if [ -r "$MVN_JAR" ]; then
  if [ "$MVNW_VERBOSE" != "false" ]; then
    echo "Found ${MVN_JAR}"
  fi
else
  if [ "$MVNW_VERBOSE" != "false" ]; then
    echo "Couldn't find ${MVN_JAR}, downloading it ..."
  fi
  if [ -n "$MVNW_REPOURL" ]; then
    WRAPPER_URL="$MVNW_REPOURL/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  else
    WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  fi
  if command -v wget > /dev/null; then
    if [ "$MVNW_VERBOSE" != "false" ]; then
      echo "Downloading from: $WRAPPER_URL"
    fi
    wget -O "$MVN_JAR" "$WRAPPER_URL"
  elif command -v curl > /dev/null; then
    if [ "$MVNW_VERBOSE" != "false" ]; then
      echo "Downloading from: $WRAPPER_URL"
    fi
    curl -o "$MVN_JAR" "$WRAPPER_URL"
  else
    die "Error: wget and curl are both missing, cannot download Maven Wrapper."
  fi
fi

exec java \
  -classpath "$MVN_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$(cd -P -- "$(dirname -- "$0")/../.." && pwd -P)" \
  $MAVEN_CONFIG \
  "$WRAPPER_LAUNCHER" \
  "$@"
